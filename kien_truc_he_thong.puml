@startuml "current"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam dpi 300
skinparam nodesep 28
skinparam ranksep 28
skinparam padding 4

skinparam package {
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 12
    FontStyle bold
    Style rectangle
}

skinparam rectangle {
    BorderThickness 1.5
    FontColor #0F172A
}

skinparam database {
    BorderThickness 1.5
    FontColor #0F172A
}

skinparam arrow {
    Color #334155
    FontColor #0F172A
    FontSize 11
    Thickness 1.4
}

package "LUỒNG NHẬN DẠNG, KIỂM ĐỊNH WAV2VEC2-VI & CĂN CHỈNH TRỰC TUYẾN" as pkg_online #F8FAFC;line:0284C7 {
    rectangle "<b>Tín hiệu âm thanh đầu vào</b>\nChuẩn hóa 16kHz Mono" as in_audio #E0F2FE;line:0284C7
    
    rectangle "<b>1. Tiền xử lý & Nén khoảng lặng</b>\nLọc Bandpass 75-7600Hz & TimeMap" as b1 #FFFFFF;line:0284C7
    
    rectangle "<b>2. Nhận dạng Ngữ cảnh (WhisperX)</b>\nMô hình <b>Whisper Large-v3</b>\n+ Hotwords ưu tiên từ CSDL" as b2 #FFFFFF;line:0284C7

    rectangle "<b>3. Kiểm định & Căn chỉnh Mức từ</b>\nMô hình <b>Wav2Vec2-VI</b> (21 tầng CTC)\nĐo điểm CTC 20ms & Biên [Start, End]" as b2b #EEF2FF;line:4F46E5
    
