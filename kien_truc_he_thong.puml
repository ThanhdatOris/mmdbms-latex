package "CSDL ĐA PHƯƠNG TIỆN HAI TẦNG (MMDBMS)                                " as pkg_db #FAF5FF;line:7C3AED {
    database "<b>Chỉ mục Vector FAISS (768-D)</b>\n6.652 Vector âm tiết chuẩn (quoc_dung)\nTrích xuất từ tầng ẩn <b>Wav2Vec2-VI</b>" as db_faiss #F3E8FF;line:7C3AED
    
    database "<b>CSDL Quan hệ SQLite (5 Bảng)</b>\nNhãn âm tiết, Mẫu .wav, 102 Quy tắc biến âm,\n1.564 Từ điển thực thể & Nhật ký đánh giá" as db_sql #F3E8FF;line:7C3AED
}

package "   HỌC NHÃN   CHỦ ĐỘNG" as pkg_feedback #FFFBEB;line:D97706 {
    rectangle "<b>5. Học nhãn bổ sung tức thì (< 0,2s)</b>\nAuto-Slice .wav + Nạp nóng Vector\n<b>Wav2Vec2-VI</b> vào FAISS & Ghi luật SQLite" as b4 #FEF3C7;line:D97706
}

' Hàng 1 luồng online: Trái sang Phải (in_audio -> b1 -> b2)
in_audio -right-> b1 : "<back:#F8FAFC> Sóng âm gốc </back>" 
b1 -right-> b2 : "<back:#F8FAFC> Sóng âm nén & </back>\n<back:#F8FAFC> Bảng TimeMap </back>"

' Chuyển xuống Hàng 2: Phải sang Trái (b2 -> b2b -> b3 -> out_text)
in_audio -[hidden]down-> out_text
b1 -[hidden]down-> b3
b2 -down-> b2b : "<back:#F8FAFC> Văn bản sơ bộ </back>"
b2b -left-> b3 : "<back:#F8FAFC> Tọa độ [Start, End], Điểm CTC </back>\n<back:#F8FAFC> & Vector Wav2Vec2 768-D </back>"
b3 -left-> out_text : "<back:#F8FAFC> Văn bản chuẩn xác </back>\n<back:#F8FAFC> (Hậu kiểm CSDL) </back>"

' Liên kết giữa Luồng Online và CSDL MMDBMS
b2 ..> db_sql
b3 <--> db_faiss : "Truy vấn Cosine\n(Phonetic Cohort)"
b3 <--> db_sql : "Trọng tài quy tắc, Từ điển 7-gram\n& Cấp Hotwords ưu tiên"

' Đồng bộ nội bộ MMDBMS
db_faiss <-right-> db_sql : "<back:#FAF5FF> <b>Đồng bộ khóa 1–1 (sample_id)</b> </back>\n<back:#FAF5FF> (Vector 768-D ↔ Siêu dữ liệu) </back>"

' Vòng lặp phản hồi học nhãn chủ động (Active Learning Loop)
out_text -down-> b4 : "Người dùng sửa từ sai / thiếu nhãn"
b4 -right-> db_faiss : "Cập nhật nóng\nFAISS & SQLite"

@enduml
